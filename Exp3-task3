<!DOCTYPE html>

<html>
<head>
    <title>Navigation and Search Bar</title>

```
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
```

</head>

<body>

```
<!-- Responsive Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <!-- Website Name -->
        <a class="navbar-brand" href="#">MyWebsite</a>

        <!-- Mobile Menu Button -->
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMenu">

            <span class="navbar-toggler-icon"></span>

        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse" id="navbarMenu">

            <ul class="navbar-nav me-auto">

                <li class="nav-item">
                    <a class="nav-link active" href="#">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">About</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">Contact</a>
                </li>

                <!-- Dropdown -->
                <li class="nav-item dropdown">

                    <a class="nav-link dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown">

                        Services

                    </a>

                    <ul class="dropdown-menu">

                        <li>
                            <a class="dropdown-item" href="#">Web Development</a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="#">App Development</a>
                        </li>

                        <li>
                            <a class="dropdown-item" href="#">Cloud Services</a>
                        </li>

                    </ul>

                </li>

            </ul>


            <!-- Search Bar -->
            <form class="d-flex">

                <div class="input-group">

                    <!-- Search Icon -->
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <!-- Search Input -->
                    <input type="search"
                           class="form-control"
                           placeholder="Search">

                    <!-- Search Button -->
                    <button class="btn btn-primary" type="submit">
                        Search
                    </button>

                </div>

            </form>

        </div>

    </div>

</nav>


<!-- Main Content -->
<div class="container mt-5">

    <h1>Welcome to MyWebsite</h1>

    <p>
        This webpage demonstrates a responsive Bootstrap
        navigation bar with a dropdown and search bar.
    </p>

</div>


<!-- Bootstrap JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
```

</body>
</html>
